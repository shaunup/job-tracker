# ------------------------------------------------------------------
# Job Tracker configuration
# Copy this file to ".env" and fill in the values.
# ------------------------------------------------------------------

# Port the server listens on (also serves the built dashboard).
PORT=4000

# ------------------------------------------------------------------
# Gmail / Google OAuth 2.0 credentials
#
# 1. Go to https://console.cloud.google.com/
# 2. Create a project, then enable the "Gmail API".
# 3. Configure the OAuth consent screen (External, add yourself as a
#    test user) and add the scope: .../auth/gmail.readonly
# 4. Create an "OAuth client ID" of type "Web application".
# 5. Add an Authorized redirect URI that EXACTLY matches
#    GOOGLE_REDIRECT_URI below (default is for local dev).
# 6. Copy the client id + secret here.
# ------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# How often (in minutes) to automatically poll Gmail for new mail and
# refresh job statuses. Set to 0 to disable automatic polling.
SYNC_INTERVAL_MINUTES=10

# How far back to look when searching Gmail (in days).
SYNC_LOOKBACK_DAYS=365

# Scheduled (cron) sync tuning. Each cron run drains the backlog in multiple
# passes until this time budget is hit. Set CRON_SECRET to require Vercel's
# cron auth header on /api/cron/sync (recommended).
# CRON_BUDGET_MS=50000
# CRON_SECRET=

# ------------------------------------------------------------------
# AI classification (recommended for accuracy)
#
# If an OpenAI-compatible API key is set, an LLM reads each email and decides
# its stage (applied/assessment/interview/offer/rejected), company, and role —
# far more accurate than keyword matching. Without a key, the app falls back to
# the built-in keyword classifier.
# ------------------------------------------------------------------
OPENAI_API_KEY=
# Optional overrides:
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# SYNC_MAX_PER_RUN=40   # new emails classified per sync (LLM is slower)

# ------------------------------------------------------------------
# Durable storage (REQUIRED on Vercel)
#
# Vercel's serverless filesystem is ephemeral, so job data and your Gmail
# connection must live in an external store. Add the Upstash Redis integration
# from the Vercel Marketplace (Storage tab) — it injects these automatically.
# Either variable pair works; the app auto-detects them.
#
# From the Vercel KV / Upstash integration:
KV_REST_API_URL=
KV_REST_API_TOKEN=
# ...or from a standalone Upstash account:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
#
# When none of the above are set, the app falls back to a local JSON file
# (./data locally). You can override that path for non-Vercel hosts:
# DATA_DIR=/data
