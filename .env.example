# ------------------------------------------------------------------
# Job Tracker configuration
# Copy this file to ".env" and fill in the values.
# ------------------------------------------------------------------

# Port the server listens on (also serves the built dashboard).
PORT=4000

# ------------------------------------------------------------------
# Gmail / Google OAuth 2.0 credentials
#
# 1. Go to https://console.cloud.google.com/
# 2. Create a project, then enable the "Gmail API".
# 3. Configure the OAuth consent screen (External, add yourself as a
#    test user) and add the scope: .../auth/gmail.readonly
# 4. Create an "OAuth client ID" of type "Web application".
# 5. Add an Authorized redirect URI that EXACTLY matches
#    GOOGLE_REDIRECT_URI below (default is for local dev).
# 6. Copy the client id + secret here.
# ------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# How often (in minutes) to automatically poll Gmail for new mail and
# refresh job statuses. Set to 0 to disable automatic polling.
SYNC_INTERVAL_MINUTES=10

# How far back to look when searching Gmail (in days).
SYNC_LOOKBACK_DAYS=365

# Where to store the local JSON database. Defaults to ./data locally and
# /tmp/jobtracker on serverless. On a host with a persistent disk, point this
# at the mounted volume (e.g. /data) so your data survives restarts.
# DATA_DIR=/data
